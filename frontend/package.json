{
  "name": "robinson-frontend",
  "version": "0.1.0",
  "description": "",
  "main": "./src/index.js",
  "scripts": {
    "development": "vite",
    "production": "serve -l 3001 -s build",
    "format": "prettier --check '**/*.jsx'",
    "format:fix": "prettier --write '**/*.jsx' '**/*.js'",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "build": "vite build",
    "test": "jest",
    "coverage": "jest --coverage --collectCoverageFrom='src/**/*.{js,jsx}'",
    "release": "release-it --verbose",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "author": "Ryan McCartney",
  "type": "module",
  "license": "GPLv3",
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/styled-engine-sc": "^9.4.0",
    "@mui/x-date-pickers": "^9.12.0",
    "barcode-detector": "^3.2.2",
    "cookie": "^2.0.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "epubjs": "^0.3.93",
    "isbn3": "^2.0.10",
    "notistack": "^3.0.2",
    "react": "^19.2.8",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-qr-code": "^2.2.0",
    "react-reader": "^2.0.15",
    "react-router-dom": "^7.18.3",
    "react-webcam": "^7.2.0",
    "serve": "^14.2.6",
    "styled-components": "^6.5.3",
    "swr": "^2.5.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.5.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.16.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "file-loader": "^6.2.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "@release-it/conventional-changelog": "^12.0.0",
    "style-loader": "^4.0.0",
    "vite": "^8.2.2"
  },
  "release-it": {
    "git": {
      "tag": false,
      "commit": false,
      "requireCleanWorkingDir": false,
      "push": false
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "conventionalcommits"
      }
    }
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false
  }
}
