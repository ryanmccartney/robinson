{
  "name": "robinson-backend",
  "version": "0.0.112",
  "description": "Backend for Robinson project",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "development": "nodemon index",
    "production": "node index",
    "docs": "node ./utils/markdown && swagger-markdown --force-version 2 -i ../docs/assets/api.yml  -o ../docs/pages/api/index.md && ../utils/api-page.sh",
    "lint": "eslint .",
    "release": "release-it --verbose",
    "changelog": "auto-changelog -p --output '../CHANGELOG.md' --commit-limit false && cp ../CHANGELOG.md ../docs/pages/changelog/index.md  && ../utils/changelog-page.sh",
    "format:fix": "prettier --write '**/*.js'",
    "format": "prettier --check '**/*.js'"
  },
  "author": "Ryan McCartney",
  "license": "GPLv3",
  "dependencies": {
    "connect-mongodb-session": "^5.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-openapi-validator": "^5.3.5",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.0",
    "fast-xml-parser": "^5.2.1",
    "get-image-colors": "^4.0.1",
    "helmet": "^8.3.0",
    "isbn3": "^2.0.10",
    "module-alias": "^2.3.4",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0",
    "nanoid": "^3.3.18",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "serve-favicon": "^2.5.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "unzipper": "^0.12.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "auto-changelog": "^2.6.0",
    "eslint": "^10.9.1",
    "jest": "^30.5.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "swagger-markdown": "^3.1.1"
  },
  "nodemonConfig": {
    "ignore": [
      "./public/*",
      "./data/*",
      "./docs/*"
    ]
  },
  "_moduleAliases": {
    "@root": ".",
    "@bin": "./bin/",
    "@routes": "./routes/",
    "@models": "./models/",
    "@utils": "./utils/",
    "@services": "./services/"
  },
  "release-it": {
    "git": {
      "requireBranch": "main",
      "requireCleanWorkingDir": false,
      "tagName": "v${version}",
      "commitMessage": "Release v${version}",
      "changelog": "npx auto-changelog --stdout --commit-limit false -u --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs"
    },
    "hooks": {
      "before:init": [
        "git pull"
      ],
      "after:bump": [
        "npm run changelog",
        "git add ../frontend/package.json",
        "git add ../frontend/package-lock.json",
        "git add ../CHANGELOG.md",
        "git add ../docs/pages/changelog/index.md"
      ]
    },
    "github": {
      "release": true,
      "releaseName": "Release v${version}"
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "conventionalcommits"
      }
    }
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false
  }
}
